<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>com.apple.security.app-sandbox</key><true/>
<!-- Read-only: installed themes and Arkiv's own theme selection. Temporary
     exceptions are permitted outside the Mac App Store and need no paid
     membership; they never grant write access. -->
<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
<array><string>/Library/Application Support/Arkiv/DocumentIconThemes/</string></array>
<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
<array><string>xyz.isharalakshan.arkiv</string></array>
</dict></plist>
